# ============ IA (DeepSeek / Jev) ============
# https://platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Razonamiento por operación (se cobra como salida): lista (clasificar,generar_cv), "todas" o "ninguna".
DEEPSEEK_RAZONAMIENTO=clasificar
# TypeSafe / Jev (opcional). Sin ella el clasificador usa DeepSeek con salida JSON forzada.
TYPESAFE_API_KEY=
# Fuerza el clasificador: "jev" o "deepseek" (si se omite, se auto-detecta).
CLASSIFIER_PROVIDER=

# ============ Supabase (OBLIGATORIO para la web) ============
# Un proyecto Supabase por entorno: "dev" (rama dev / Vercel Preview) y "prod" (rama main / Production).
# Postgres: Project Settings -> Database -> Connection string -> "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Storage: Project Settings -> API. La clave de servicio es SECRETA: solo en el servidor.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cvs

# ============ Web ============
# URL pública (link del correo de recuperación). En Vercel se usa VERCEL_URL si no se define.
APP_URL=http://127.0.0.1:8000
WEB_HOST=127.0.0.1
WEB_PORT=8000
PERMITIR_REGISTRO=true
# Si se define, registrarse (incluida la primera cuenta) exige este código. RECOMENDADO en producción.
CODIGO_INVITACION=

# Recuperación de contraseña por correo (opcional). Gmail: smtp.gmail.com:587 + "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============ Bot de Telegram (solo local, no va a Vercel) ============
TELEGRAM_BOT_TOKEN=
# Tu user_id numérico (whitelist; obtenlo con @userinfobot)
TELEGRAM_ALLOWED_USER_ID=
PROJECT_ROOT=
